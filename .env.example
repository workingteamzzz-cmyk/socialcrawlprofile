# Copy to .env (never commit .env) and fill in.
# Your domain, pointed at this server (DNS A record):
DOMAIN=collector.example.com

# One key per person — make each with:  openssl rand -hex 24
# Remove someone's entry and run `docker compose up -d` to lock them out.
COLLECTOR_API_KEYS=ana=replace-with-a-long-random-key,budi=replace-with-another-long-random-key

# Optional: only these addresses may connect (your office's public IP / VPN), comma separated.
ALLOWED_IPS=

# "I'm not a robot": how long to wait for someone to solve it on the dashboard, and an optional
# webhook (Slack/Teams/n8n) to be told when one is waiting.
CAPTCHA_WAIT_MINUTES=10
CAPTCHA_WEBHOOK_URL=
PUBLIC_URL=https://collector.example.com

# How long things are kept
SESSION_DAYS=7
RETENTION_DAYS=30
DEBUG_RETENTION_DAYS=7
